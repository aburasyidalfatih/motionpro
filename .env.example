# Salin file ini menjadi .env lalu sesuaikan nilainya: cp .env.example .env
# Nilai default di bawah cocok dengan docker-compose.yml.

# --- Wajib (Fase 0) ---
# Port harus sama dengan POSTGRES_PORT (default 5433, lihat docker-compose.yml).
POSTGRES_PORT=5433
DATABASE_URL="postgresql://motionpro:motionpro@localhost:5433/motionpro"
REDIS_URL="redis://localhost:6379"

# Folder penyimpanan lokal untuk aset, audio, dan video hasil render.
STORAGE_DIR="./storage"

# --- MinIO / S3 (dipakai mulai Fase 2; nanti diganti Cloudflare R2 atau S3 di VPS) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="motionpro"
S3_SECRET_KEY="motionpro-secret"
S3_BUCKET="motionpro"

# --- API key (diisi saat fase terkait dimulai) ---
# Fase 1: riset dan naskah. Buat API key di https://aistudio.google.com
GEMINI_API_KEY=""
# Model Gemini; kosongkan untuk memakai default (gemini-3.8-flash).
GEMINI_MODEL=""
# Model untuk kerangka, penulisan, dan pemeriksaan naskah; kosongkan untuk memakai GEMINI_MODEL.
# Isi dengan model Gemini Pro bila billing aktif: naskah adalah bagian yang paling menentukan kualitas video.
GEMINI_SCRIPT_MODEL=""
# Isi "off" untuk melewati pemeriksaan editor per bab (menghemat kuota, kualitas naskah turun).
SCRIPT_REVIEW=""
# Jumlah pencarian riset paralel; biarkan 1 untuk akun gratis, naikkan bila billing aktif.
GEMINI_CONCURRENCY="1"
# Isi "fake" untuk menguji alur aplikasi dengan data contoh tanpa memanggil Gemini.
AI_PROVIDER=""
# Fase 2: aset dan voice over
# Footage video dan foto dari Pexels (gratis: https://www.pexels.com/api). Wikimedia Commons tidak perlu key.
PEXELS_API_KEY=""
# Koordinat titik peta dicek di OpenStreetMap (Nominatim, gratis, tanpa key). "off" untuk mematikan;
# mode tiruan (AI_PROVIDER=fake) mematikannya kecuali diisi "on". GEOCODER_URL untuk server Nominatim sendiri.
GEOCODER=""
GEOCODER_URL=""
# Model Gemini TTS untuk voice over; kosongkan untuk default (gemini-3.8-flash-tts).
GEMINI_TTS_MODEL=""
# Keragaman suara TTS (0–2). Lebih rendah = narator lebih konsisten antaradegan; kosongkan untuk 0.6.
GEMINI_TTS_TEMPERATURE=""
# Folder musik latar dan efek suara (lihat library/README.md).
LIBRARY_DIR="./library"

# --- Render (Fase 3) ---
# Jumlah tab Chrome paralel saat render; kosongkan untuk default Remotion (setengah jumlah core CPU).
RENDER_CONCURRENCY=""
# Path Chrome/Chromium bila Remotion tidak bisa mengunduh Chrome headless sendiri.
REMOTION_BROWSER_EXECUTABLE=""
