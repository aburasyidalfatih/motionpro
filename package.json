{
  "name": "motionpro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker": "tsx watch src/worker/index.ts",
    "dev:all": "concurrently -n web,worker -c blue,magenta \"npm:dev\" \"npm:worker\"",
    "build": "next build",
    "start": "next start",
    "worker:start": "tsx src/worker/index.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "whisper:setup": "tsx src/scripts/setup-whisper.ts",
    "check:ai": "tsx src/scripts/check-ai.ts",
    "map:data": "tsx src/scripts/build-map-data.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@remotion/bundler": "4.0.529",
    "@remotion/effects": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/install-whisper-cpp": "4.0.529",
    "@remotion/motion-blur": "4.0.529",
    "@remotion/player": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "bullmq": "^6.3.9",
    "d3-geo": "^3.1.1",
    "ioredis": "^6.0.0",
    "milsymbol": "3.0.4",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.529",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.529",
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
